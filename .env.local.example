# Copy this file to .env.local (gitignored) and fill in your own values for local dev.

# Gemini classification - get a free key at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Firebase - from Firebase console > Project settings > Your apps > Web app > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
