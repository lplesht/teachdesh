rules_version = '2';

// Real access control. Every visitor signs in anonymously (src/firebase.ts),
// then logs in by creating sessions/{uid} = {phone, code}; the write itself is
// the code check (it only succeeds if `code` matches users/{phone}.code).
//
// One person = one phone = one code = one users/{phone} doc, which also lists
// every class they belong to and their role in each:
//   users/{phone} = { displayName, code, classes: { g4: 'parent', b1: 'teacher' } }
// Roles are always read from there, never from the client. Only the single
// admin (the one users doc created by hand in the console with admin: true)
// can create/edit/delete users - teachers manage nothing but their class.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function sessionPath() {
      return /databases/$(database)/documents/sessions/$(request.auth.uid);
    }

    function userPath(phone) {
      return /databases/$(database)/documents/users/$(phone);
    }

    // Logged in = has a session whose phone+code still match that user's
    // current code, so changing/deleting a user kicks their old sessions out.
    function loggedIn() {
      return signedIn()
        && exists(sessionPath())
        && exists(userPath(get(sessionPath()).data.phone))
        && get(userPath(get(sessionPath()).data.phone)).data.code == get(sessionPath()).data.code;
    }

    function myPhone() {
      return get(sessionPath()).data.phone;
    }

    function me() {
      return get(userPath(myPhone())).data;
    }

    function isAdmin() {
      return loggedIn() && me().get('admin', false) == true;
    }

    function isMember(classId) {
      return loggedIn() && me().classes.get(classId, null) != null;
    }

    function isTeacher(classId) {
      return loggedIn() && me().classes.get(classId, null) == 'teacher';
    }

    // Israeli mobile (05X-XXXXXXX), landline (0[2-4,8,9]-XXXXXXX) or VoIP (07X-XXXXXXX).
    function validPhone(phone) {
      return phone.matches('^(05[0-9]{8}|07[0-9]{8}|0[23489][0-9]{7})$');
    }

    function validUser(d) {
      return d.keys().hasOnly(['displayName', 'code', 'classes', 'admin'])
        && d.keys().hasAll(['displayName', 'code', 'classes'])
        && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 60
        && d.code is string && d.code.size() >= 4 && d.code.size() <= 12
        && d.classes is map
        && d.classes.values().hasOnly(['parent', 'teacher']);
    }

    match /sessions/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['phone', 'code'])
        && exists(userPath(request.resource.data.phone))
        && get(userPath(request.resource.data.phone)).data.code == request.resource.data.code;
    }

    match /users/{phone} {
      // Everyone may read their own doc (role per class, display name); the
      // admin reads/lists everyone's.
      allow get: if loggedIn() && (myPhone() == phone || isAdmin());
      allow list: if isAdmin();
      // The admin flag can only be set by hand in the console - this rule
      // never lets it be created, changed or removed from the app.
      allow create: if isAdmin() && validPhone(phone) && validUser(request.resource.data)
        && request.resource.data.get('admin', false) == false;
      allow update: if isAdmin() && validUser(request.resource.data)
        && request.resource.data.get('admin', false) == resource.data.get('admin', false);
      allow delete: if isAdmin() && resource.data.get('admin', false) == false;
    }

    // Legacy per-class login lists, kept only so the admin can import them
    // once into users/ (see UserManagerModal). Nothing authorizes from here.
    match /classes/{classId}/access/{phone} {
      allow read, delete: if isAdmin();
    }

    match /classes/{classId}/messages/{messageId} {
      allow read: if isMember(classId);
      allow create, delete: if isTeacher(classId);
      // Parents may only toggle their own entry in likedBy (phone -> name) -
      // never anyone else's, and nothing else about a message (routing
      // tags, text) is theirs to touch.
      allow update: if isTeacher(classId)
        || (isMember(classId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
            // Messages sent before this feature existed have no likedBy map
            // yet - treat that as an empty one rather than erroring the diff.
            && request.resource.data.likedBy.diff('likedBy' in resource.data ? resource.data.likedBy : {}).affectedKeys().hasOnly([myPhone()]));
    }

    match /classes/{classId}/presence/{phone} {
      // Simple online/last-seen heartbeat (src/presence.ts) - any class
      // member can see who else is around, but only touch their own entry.
      // The admin can see and clean up everyone's.
      allow read: if isMember(classId) || isAdmin();
      allow write: if isMember(classId) && myPhone() == phone;
      allow delete: if isAdmin();
    }

    match /classes/{classId}/pushTokens/{phone} {
      // Each viewer registers their own push token (src/push.ts); the
      // notifyOnNewMessage Cloud Function reads these via the Admin SDK,
      // which bypasses rules entirely - only the teacher needs client read
      // access, and only to show who has notifications on. The admin can
      // delete a token when removing someone from a class.
      allow read: if isTeacher(classId);
      allow write: if isMember(classId) && myPhone() == phone;
      allow delete: if isAdmin();
    }

    match /classes/{classId}/events/{eventId} {
      allow read: if isMember(classId);
      allow create, delete: if isTeacher(classId);
      // Parents may only adjust the RSVP counters.
      allow update: if isTeacher(classId)
        || (isMember(classId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvpYes', 'rsvpNo']));
    }

    // Everything else under a class (assignments, announcements, photos,
    // meta/roster) - members read, only the teacher writes. Overlapping
    // match blocks are OR-ed together, so this broad rule must explicitly
    // exclude the collections that have their own stricter rules above
    // (access holds everyone's login codes; pushTokens are device tokens) -
    // otherwise it would quietly re-open them to every member/teacher.
    match /classes/{classId}/{collection}/{docId} {
      allow read: if isMember(classId) && !(collection in ['access', 'pushTokens']);
      allow write: if isTeacher(classId) && !(collection in ['access', 'pushTokens']);
    }
  }
}
