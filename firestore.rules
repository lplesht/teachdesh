rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isMemberOf(classId) { return isSignedIn() && classId in userDoc().data.classIds; }
    function isTeacherOf(classId) { return isMemberOf(classId) && userDoc().data.role == 'teacher'; }
    function isVerifiedParentOf(classId) {
      return isMemberOf(classId) && userDoc().data.role == 'parent' && request.auth.token.email_verified == true;
    }
    function canAccess(classId) { return isTeacherOf(classId) || isVerifiedParentOf(classId); }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;

      // Parent self-signup: only allowed if the caller's email already has an
      // unclaimed (or self-claimed) allowedParents entry for that class.
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == 'parent'
        && request.resource.data.classIds.size() == 1
        && get(/databases/$(database)/documents/classes/$(request.resource.data.classIds[0])/allowedParents/$(myEmail()))
             .data.claimedByUid in [null, request.auth.uid];

      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role; // no client-side role change
      allow delete: if false;
    }

    match /classes/{classId} {
      allow read: if canAccess(classId);
      allow write: if isTeacherOf(classId);

      match /students/{studentId} {
        allow read: if canAccess(classId);
        allow write: if isTeacherOf(classId);
      }

      match /allowedParents/{emailKey} {
        // Teacher manages the list, but can never set claimedByUid directly.
        allow read: if isTeacherOf(classId);
        allow create, delete: if isTeacherOf(classId);
        allow update: if (isTeacherOf(classId)
              && !('claimedByUid' in request.resource.data.diff(resource.data).affectedKeys()))
          || (isSignedIn() && emailKey == myEmail()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedByUid', 'claimedAt'])
              && resource.data.claimedByUid in [null, request.auth.uid]
              && request.resource.data.claimedByUid == request.auth.uid);
      }

      match /messages/{messageId} {
        allow read: if canAccess(classId);
        allow create, delete: if isTeacherOf(classId);
        allow update: if isTeacherOf(classId)
          || (canAccess(classId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy']));
      }

      match /events/{eventId} {
        allow read: if canAccess(classId);
        allow create, update, delete: if isTeacherOf(classId);

        match /rsvps/{uid} {
          allow read: if canAccess(classId);
          allow write: if isSignedIn() && request.auth.uid == uid && canAccess(classId);
        }
      }

      match /reminders/{reminderId} {
        allow read: if canAccess(classId);
        allow write: if isTeacherOf(classId);
      }

      match /photos/{photoId} {
        allow read: if canAccess(classId);
        allow create, update, delete: if isTeacherOf(classId);
      }
    }
  }
}
