rules_version = '2';

// TEMPORARY, simplified rules for the initial Firebase cutover: every
// visitor signs in anonymously (see src/firebase.ts), and any signed-in
// user can read/write the single class's data. There is no real teacher
// vs. parent distinction enforced yet - the "role" toggle in the app is
// still just a UI switch. Real per-role accounts + an allow-list are the
// next phase; harden these rules when that lands.
service cloud.firestore {
  match /databases/{database}/documents {
    match /classes/{classId}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
