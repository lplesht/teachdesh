rules_version = '2';

// Real access control: every visitor signs in anonymously (src/firebase.ts),
// then must hold a sessions/{uid} doc created by a successful phone+code
// login (src/auth/session.ts). The session only stores {classId, phone} -
// role always comes from following sessions/{uid} -> classes/{classId}/access/{phone},
// never from the client, so nobody can claim their own role.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasSession() {
      return signedIn() && exists(/databases/$(database)/documents/sessions/$(request.auth.uid));
    }

    function mySession() {
      return get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data;
    }

    function isMember(classId) {
      return hasSession() && mySession().classId == classId;
    }

    function myAccessDoc(classId) {
      let s = mySession();
      return get(/databases/$(database)/documents/classes/$(classId)/access/$(s.phone)).data;
    }

    function isTeacher(classId) {
      return isMember(classId) && myAccessDoc(classId).role == 'teacher';
    }

    match /sessions/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      // The write itself is the code check: it succeeds only if `code`
      // matches the stored access doc's code for that classId+phone.
      allow create: if signedIn() && request.auth.uid == uid
        && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)/access/$(request.resource.data.phone)).data.code == request.resource.data.code;
      allow update: if false; // re-login = delete then create fresh
    }

    match /classes/{classId}/access/{phone} {
      // A parent may read only her own entry (to know her own role/display
      // name); a teacher may read/list/write the whole class's list.
      allow read: if isMember(classId) && (mySession().phone == phone || myAccessDoc(classId).role == 'teacher');
      allow write: if isTeacher(classId);
    }

    match /classes/{classId}/messages/{messageId} {
      allow read: if isMember(classId);
      allow create, delete: if isTeacher(classId);
      // Parents may only toggle their own entry in likedBy (phone -> name) -
      // never anyone else's, and nothing else about a message (routing
      // tags, text) is theirs to touch.
      allow update: if isTeacher(classId)
        || (isMember(classId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
            // Messages sent before this feature existed have no likedBy map
            // yet - treat that as an empty one rather than erroring the diff.
            && request.resource.data.likedBy.diff('likedBy' in resource.data ? resource.data.likedBy : {}).affectedKeys().hasOnly([mySession().phone]));
    }

    match /classes/{classId}/presence/{phone} {
      // Simple online/last-seen heartbeat (src/presence.ts) - any class
      // member can see who else is around, but only touch their own entry.
      allow read: if isMember(classId);
      allow write: if isMember(classId) && mySession().phone == phone;
    }

    match /classes/{classId}/events/{eventId} {
      allow read: if isMember(classId);
      allow create, delete: if isTeacher(classId);
      // Parents may only adjust the RSVP counters.
      allow update: if isTeacher(classId)
        || (isMember(classId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvpYes', 'rsvpNo']));
    }

    // Everything else under a class (assignments, announcements, photos,
    // meta/roster) - members read, only the teacher writes.
    match /classes/{classId}/{collection}/{docId} {
      allow read: if isMember(classId);
      allow write: if isTeacher(classId);
    }
  }
}
