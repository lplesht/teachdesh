rules_version = '2';

// TEMPORARY, simplified rules matching firestore.rules for now - any
// signed-in (including anonymous) visitor can read/write class photos,
// capped at 8MB. Harden alongside real auth in the next phase.
service firebase.storage {
  match /b/{bucket}/o {
    match /classes/{classId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 8 * 1024 * 1024;
    }
  }
}
