rules_version = '2';

// Mirrors firestore.rules: a class member (real session, not just anonymous
// auth) may read; only that class's teacher may write, capped at 8MB and
// images only.
service firebase.storage {
  match /b/{bucket}/o {

    function userData() {
      return firestore.get(/databases/(default)/documents/users/$(firestore.get(/databases/(default)/documents/sessions/$(request.auth.uid)).data.phone)).data;
    }

    function isMember(classId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/sessions/$(request.auth.uid))
        && userData().classes.get(classId, null) != null;
    }

    function isTeacher(classId) {
      return isMember(classId) && userData().classes.get(classId, null) == 'teacher';
    }

    match /classes/{classId}/{allPaths=**} {
      allow read: if isMember(classId);
      allow write: if isTeacher(classId)
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
